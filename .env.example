# copy to .env — docker-compose reads RP_ID/ORIGIN from this file
# (DATABASE_URL below is only used for local `npm run dev`; docker-compose
# overrides it to point at the mounted volume)
DATABASE_URL="file:./dev.db"

# WebAuthn/security-key settings — REQUIRED, and must match how you actually
# access the site, or registering/logging in with a key will fail.
#
# RP_ID is your domain with no scheme/port, e.g. "books.example.com".
# ORIGIN is the full URL including scheme, e.g. "https://books.example.com".
#
# Security keys only work over HTTPS, with one exception: RP_ID=localhost
# (and ORIGIN=http://localhost:8312) is allowed over plain HTTP, which is
# fine for local dev but not for reaching the app from another device.
# For a real deployment you need TLS in front of this container — a
# reverse proxy with automatic HTTPS (Caddy, Traefik) or something like
# Tailscale's HTTPS certificates both work well for a self-hosted app like
# this one.
RP_ID=localhost
ORIGIN=http://localhost:8312
